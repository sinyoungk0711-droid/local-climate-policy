# Copy this file to .env and replace placeholder values locally.
# Never commit your real .env or API key.
OPENAI_API_KEY=replace_with_your_api_key
OPENAI_MODEL=gpt-4.1-mini

# Public Data Portal: KMA ASOS daily observation API key
KMA_SERVICE_KEY=replace_with_your_data_go_kr_service_key

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=local_climate_policy
DB_USER=your_mysql_user
DB_PASSWORD=replace_with_your_password

# Generate with: py -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
